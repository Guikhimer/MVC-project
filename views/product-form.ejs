<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= editing ? 'Editar produto' : 'Novo produto' %> | Vitrine</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/header', { page }) %>
  <main class="container auth-wrap">
    <section class="auth-card product-form-card">
      <span class="eyebrow">Catálogo</span>
      <h1><%= editing ? 'Editar produto' : 'Cadastrar produto' %></h1>
      <p>O item será salvo no MongoDB Atlas e aparecerá imediatamente na vitrine.</p>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <form action="<%= action %>" method="post">
        <div class="field"><label for="name">Nome do produto</label><input id="name" name="name" value="<%= product.name %>" required maxlength="100"></div>
        <div class="field"><label for="description">Descrição</label><textarea id="description" name="description" required maxlength="600"><%= product.description %></textarea></div>
        <div class="form-row">
          <div class="field"><label for="price">Preço (R$)</label><input id="price" type="number" name="price" value="<%= product.price %>" min="0" step="0.01" required></div>
          <div class="field"><label for="stock">Estoque</label><input id="stock" type="number" name="stock" value="<%= product.stock %>" min="0" step="1" required></div>
        </div>
        <button class="button" type="submit"><%= editing ? 'Salvar alterações' : 'Salvar produto' %></button>
      </form>
    </section>
  </main>
</body>
</html>
